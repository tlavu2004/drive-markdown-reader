{
  "manifest_version": 3,
  "name": "Drive Markdown Reader",
  "version": "1.0",
  "description": "Renders Markdown files directly in Google Drive preview.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Render Markdown"
  },
  "content_scripts": [
    {
      "matches": [
        "https://drive.google.com/*"
      ],
      "js": [
        "vendor/marked/marked.min.js",
        "vendor/mermaid/mermaid.min.js",
        "src/content/drive.js",
        "src/content/index.js"
      ],
      "css": [
        "src/viewer/viewer.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/marked/marked.min.js",
        "vendor/mermaid/mermaid.min.js",
        "src/viewer/viewer.css",
        "src/viewer/index.html",
        "src/viewer/viewer.js",
        "src/viewer/render.js",
        "vendor/dompurify/purify.min.js"
      ],
      "matches": [
        "https://drive.google.com/*"
      ]
    }
  ]
}
