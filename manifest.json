{
  "manifest_version": 3,
  "name": "Drive Markdown Reader",
  "version": "1.0.0",
  "description": "Read Markdown and render Mermaid diagrams directly in Google Drive.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Render Markdown"
  },
  "content_scripts": [
    {
      "matches": [
        "https://drive.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/viewer/index.html",
        "assets/*",
        "vendor/marked/marked.min.js",
        "vendor/mermaid/mermaid.min.js",
        "vendor/dompurify/purify.min.js"
      ],
      "matches": [
        "https://drive.google.com/*"
      ]
    }
  ]
}
