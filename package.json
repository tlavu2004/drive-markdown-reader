{
  "name": "drive-markdown-reader",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "npm run build && node --test tests/*.test.ts",
    "vendor": "node scripts/vendor.ts",
    "verify:extension": "node scripts/verify-extension.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build.ts",
    "dev": "npm run build && node scripts/build.ts --watch",
    "check": "npm test && npm run verify:extension"
  },
  "dependencies": {
    "dompurify": "3.4.18",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.6.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "jsdom": "31.0.1",
    "marked": "15.0.12",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "type": "module"
}
